  "narrative": {
    "northStar": "The Pocket Workbench",
    "overview": "A developer's desk laid out in front of you: a phone mockup showing the work, a row of tool icons, and project tiles arranged like parts on a bench. Each tile is a bright block of color that opens into a dark detail card. Playful and bold in color and headline type, held in check by polished, restrained details; tactile and friendly components; never a generic template portfolio.",
    "keyCharacteristics": [
      "Saturated tile colors on warm cream (light) or charcoal (dark).",
      "Two physical languages: light mode is hard-edged (squared, black outlines, offset shadows), dark mode is soft (rounded, diffuse shadow).",
      "Audiowide for every heading and control, Manrope for everything read.",
      "Motion is GSAP: staggered scroll-in for tiles, Flip transitions between tile and popup."
    ],
    "rules": [
      {
        "name": "The Color Lives in Tiles Rule",
        "body": "Saturated hues fill project tiles. Text stays Ink or Night Text, never a tile color.",
        "section": "colors"
      },
      {
        "name": "The Dark Popup Rule",
        "body": "The project popup is Night with Night Text in both themes, so screenshots sit on a calm ground.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Audiowide for anything the visitor scans or presses, Manrope for anything they read.",
        "section": "typography"
      },
      {
        "name": "The One Language Per Theme Rule",
        "body": "A theme uses one depth language throughout. Never put a soft blurred shadow on a light-mode tile, or a hard black outline on a dark-mode one.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put color in the tiles and keep text Ink or Night Text.",
      "Do use Audiowide for headings and controls, Manrope for reading text.",
      "Do keep each theme to its own depth language (hard in light, soft in dark).",
      "Do animate with GSAP: staggered tile entrance, Flip for tile to popup, about 0.2 to 0.4s with power2 easing.",
      "Do keep the popup dark in both themes."
    ],
    "donts": [
      "Don't let the site become a generic template portfolio: a dark hero with gradient text over an identical card grid.",
      "Don't mix hard and soft depth within one theme.",
      "Don't set body copy in Audiowide.",
      "Don't put tile colors behind long text.",
      "Don't use --clr-lightpurple or --border-sm: they are undefined.",
      "Don't treat the temporary theme button and duplicated light-mode blocks as part of the system."
    ]
  }
