---
import { Icon } from 'astro-icon/components';
import Panel from './Panel.astro';

const stack = [
  "HTML",
  "CSS",
  "JavaScript",
  "React",
  "Astro",
  "Tailwind CSS",
  "Cloudflare Workers / D1",
  "Headless CMS (Sanity, Strapi)",
  "Stripe",
  "GSAP",
];
---

<div class="wrapper">
  <section class="hero">
    <h1>
      Hello I'm Hayoun
    </h1>
    <p>I like to bring ideas into web.</p>
    <div class="bottom">
      <div>
        <ul class="tech-stack">
          {stack.map((tech) => <li>{tech}</li>)}
        </ul>
      </div>
      <div class="location">
        <Icon name="mdi:map-marker-radius-outline" />
        <span>Los Angeles</span>
      </div>
    </div>
  </section>
  <Panel />
</div>

<style>
  .wrapper {
    padding-block: 80px;
    display: flex;
    justify-content: space-between;
  }

  .hero {
    /* height: 400px; */
    margin-top: 90px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: light-dark(white,transparent);
  }

  h1 {
    font-size: 5rem;
  }

  p {
    font-size: 2rem;
    color: light-dark(var(--light-color), rgb(195,195,195));
  }

  .bottom {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-stack li {
    font-size: 0.85rem;
    padding: 2px 10px;
    border: 1px solid light-dark(black, rgb(120, 120, 120));
    border-radius: 999px;
    background-color: light-dark(rgb(245 245 245), rgb(33, 33, 33));
  }

  @media (prefers-color-scheme: light) {
    .hero {
      padding: 20px;
      box-shadow: 5px 5px black;
      border: 3px solid black;
    }
  }

  @media screen and (width < 720px) {
    h1 {
      font-size: 3.5rem;
    }

    .hero {
      margin-bottom: 90px;
      display: flex;
      flex-direction: column;
      gap: 50px;
    }

    .wrapper {
      display: flex;
      flex-direction: column;
    }
  }
</style>