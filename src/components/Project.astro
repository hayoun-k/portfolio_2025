---
import { Icon } from 'astro-icon/components';

import { Image } from 'astro:assets';
import NetConfig from '../assets/image/works/Network-Configure.png';
import LandingPage from '../assets/image/works/landing-page_2.png';
import Chart from '../assets/image/works/js-simulation-chart.png';
import Sig from '../assets/image/works/email-signature.png';
import ScoutPic from '../assets/image/works/photo-search-app.jpg';
import Oreobot from '../assets/image/works/oreobot.png';
import CafePlaceholder from '../assets/image/works/maple-moss.png'; // TODO: replace with a screenshot of https://maple-moss-test.pages.dev/

const workImages = import.meta.glob("../assets/image/works/*.png", { eager: true, import: "default" });
const workImageList = Object.values(workImages);

const getImage = "../src/assets/image/works/";


const projects = [
    // {
    //   projectImage: NetConfig, 
    //   projectTitle: "Network Setup Page", 
    //   projectDescription: "This sleek and minimal HTML project is all about helping users set up their network connections—just like configuring a router! Whether it’s client-based or server-based, users can easily manage their network details like IP addresses, servers, and gateways without any fuss. It’s a no-frills, user-friendly interface that keeps things simple!"
    // },
        {
      projectImage: CafePlaceholder,
      projectTitle: "Maple & Moss Café Demo",
      projectDescription: "Maple & Moss is a demo website for a fictional neighborhood café. It shows how a small local business could pair a polished, easy-to-browse website with an AI chatbot. The site covers the café’s menu, hours, location, and atmosphere in a warm, cozy design that works on desktop and mobile. The embedded chatbot answers customer questions in plain language, such as “What’s vegan?”, “Are you open on Sunday?”, or “What goes well with a latte?” It answers from the café’s own menu and details, so visitors get quick, accurate answers without calling or searching through pages. I built it as a proof of concept to explore how conversational AI can improve the customer experience for small businesses. I worked on every layer, from the visual design to how the chatbot behaves.",
      techStack: [
        "Cloudflare Pages & Pages Functions",
        "Workers AI",
        "AI Gateway",
        "D1",
        "OpenAI GPT-6 Luna",
        "Vanilla HTML/CSS/JS",
      ],
    },
    {
      projectImage: LandingPage, 
      projectTitle: "Landing Page Development", 
      projectDescription: "When it comes to developing landing pages, I’m all about building high-performing, lightning-fast pages that get results. I take your vision and turn it into a seamless, responsive experience using clean, efficient code. From integrating dynamic content to optimizing load times, I make sure every detail works perfectly across all devices. Ready for a landing page that not only looks great but works like a charm? Let’s make it happen!"
    },
    // {
    //   projectImage: `${getImage}landing_page_webcosmos_desktop.png`, 
    //   projectTitle: "Landing Page Development", 
    //   projectDescription: "When it comes to developing landing pages, I’m all about building high-performing, lightning-fast pages that get results. I take your vision and turn it into a seamless, responsive experience using clean, efficient code. From integrating dynamic content to optimizing load times, I make sure every detail works perfectly across all devices. Ready for a landing page that not only looks great but works like a charm? Let’s make it happen!"
    // },
    {
      projectImage: Chart, 
      projectTitle: "Maplestory Simulator", 
      projectDescription: "This is a custom-built web simulator designed for the Oreo Guild players on MapleStory's GMS Heroic servers (Kronos, Hyperion). It allows users to simulate Starforce enhancements by inputting equipment level, starting star, goal star, and various event settings like Starcatch, Shining StarForce events, Safeguard options, and MVP discounts. The simulator calculates meso consumption, enhancement attempts, item destruction chances, and provides detailed simulation logs, results, and statistical insights. It also features a cost table and success rate table for Starforcing based on user settings, complete with visualized simulation data using Plotly.js."
    },

    {
      projectImage: Sig, 
      projectTitle: "Responsive Email Signature", 
      projectDescription: "Responsive, cross-platform email signature development"
    },
    {
      projectImage: ScoutPic, 
      projectTitle: "ScoutPicFinder", 
      projectDescription: "This is a clean, responsive image search app built with Next.js. It allows users to search for photos using the Unsplash API and view results instantly. Users can open original images or download them in small, medium, or large sizes. The project features custom components like SearchBar, ImageList, and ImageShow, clean API handling with Axios, simple navigation with a logo and About page link, and custom fonts for a polished look. It’s fully responsive and credits Unsplash photographers in the footer."
    },
    {
      projectImage: Oreobot,
      projectTitle: "Discord Bot Development",
      projectDescription: "A lightweight Discord bot built with JavaScript and Cloudflare Workers. It responds to slash commands like <code>/oreo</code> to send a random post from r/Oreos, and /ursus to display time windows adjusted to the user’s local time. The bot runs serverlessly, securely handles Discord interactions, and includes a custom script for registering commands globally."

    },
    // {
    //   projectImage: `${getImage}PH_coming_soon.png`,
    //   projectTitle: "Landing Page Design",
    //   projectDescription: "Lorem Ipsum",
    // },
  ];
    console.log(projects[1].projectImage.src);
  const { class: className, } = Astro.props;
// const {projectImage, projectTitle, projectDescription } = Astro.props;
---
<div class="trigger"></div>
<div class={className}>
  {projects.map((project, index) => (
    <div class="bento-item" key={project.projectTitle || index}>
      <div class="project-wrapper">
  
        <div class="content" style={{backgroundImage: `url(${project.projectImage.src})`}}>
  
        </div>
        <dialog class="project-popup dialog">
          <div class="popup-wrapper">
            <button type="button" class="closebutton" aria-label="Close project details">
              <Icon name="mdi:close" />
            </button>
            <div class="popup-img-container">
              <Image src={project.projectImage} alt={project.projectTitle} class="popup-img" />
            </div>
            <div class="popup-text">
              <h3 class="popup-title">{project.projectTitle}</h3>
              <p class="popup-description">
                {project.projectTitle === "Discord Bot Development" ? (
                  <>
                    A lightweight Discord bot built with JavaScript and Cloudflare Workers.
                    It responds to slash commands like <code>/oreo</code> to send a random post from r/Oreos,
                    and <code>/ursus</code> to display time windows adjusted to the user’s local time.
                    The bot runs serverlessly, securely handles Discord interactions, and includes a custom script for registering commands globally.
                  </>
                ) : (
                  project.projectDescription
                )}
              </p>
              {project.techStack?.length > 0 && (
                <div class="tech-stack">
                  <h4 class="tech-stack-title">Tech stack</h4>
                  <ul class="tech-stack-list">
                    {project.techStack.map((tech) => (
                      <li class="tech-stack-item">{tech}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </dialog>
      </div>
    </div>
  ))}
</div>

<script src="./projectAnimation.js"></script>
<style>
  .content {
    width: 100%;
    height: 100%;
  }

  .bento-container {
  max-width: 1200px;
  margin-top: 2rem;
  margin-inline: auto;
  padding: 32px;
  display: grid;
  grid-template-areas:
    "a b b "
    "a c d "
    "e e f "
    "g g g ";
  gap: 24px;
  background-color: var(--clr-lightpurple);
  border: var(--border-sm);
  position: relative;
}

/* Dim the siblings on the wrapper, not the item: GSAP owns the items' opacity. */
.bento-container:has(.bento-item:hover) .bento-item:not(:hover) .project-wrapper {
  opacity: 0.7;
}

.project-wrapper {
  width: 100%;
  height: 100%;
  position: relative;
  transition: opacity 0.2s ease-out;
}

.bento-item {
  height: 100%;
  padding: 40px;
  border-radius: 15px;
  position: relative;
}

.bento-item:nth-of-type(1) {
  grid-area: a;
  background-color: light-dark(var(--light-blue),#5078f3);
  .content {
    background-size: cover;
  }
}

.bento-item:nth-of-type(2) {
  grid-area: b;
  background-color: light-dark(var(--light-green),#b4ffda);
  .content {
    background-size: cover;
    background-position-x: 50%;
  }
}
.bento-item:nth-of-type(3) {
  grid-area: c;
  background-color: light-dark(var(--light-green),#b4ffda);
  .content {
    background-size: cover;
  }
}
.bento-item:nth-of-type(4) {
  grid-area: d;
  background-color: light-dark(var(--light-red),#b398ff);
  .content {
    background-size: cover;
  }
}
.bento-item:nth-of-type(5) {
  grid-area: e;
  background-color: light-dark(var(--light-ylw),#ffe552);
  .content {
    background-size: cover;
    background-position-x: 50%;
  }
}
.bento-item:nth-of-type(6) {
  grid-area: f;
  background-color: light-dark(var(--light-ylw),#ffe552);
  .content {
    background-size: cover;
  }
}
.bento-item:nth-of-type(7) {
  grid-area: g;
  background-color: #ffb4e6;
  .content {
    background-size: cover;
  }
}
.bento-item:nth-of-type(8) {
  grid-area: h;
  background-color: #ffb4e6;
  .content {
    background-size: cover;
    background-position: 50%;
  }
}
.bento-item:nth-of-type(9) {
  grid-area: i;
  background-color: light-dark(var(--light-blue),#5078f3);
  .content {
    background-size: cover;
  }
}

.bento-item .content {
  min-height: 250px;
  border-radius: 12px;
  filter: drop-shadow(0 0 20px rgba(0,0,0,0.25));
  background-position: center top;
}

.project-popup[open] {
  padding: 2rem 3rem 3rem;
  border: none;
  border-radius: 15px;
  background-color: rgb(33,33,33);
  color: rgb(235, 235, 235);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.project-popup:focus-visible {
  outline: none;
}

.project-popup::backdrop {
  background-color: rgba(105, 105, 105, 0.3);
}

.popup-wrapper {
  height: min(800px, calc(100dvh - 8rem));
  display: grid;
  grid-template-columns: 2.5fr 1.5fr;
  column-gap: 60px;
}

.closebutton {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  position: absolute;
  top: 0.5rem;
  right: 0.75rem;
  border: none;
  border-radius: 50%;
  background: none;
  color: inherit;
  font-size: 1.5rem;
  cursor: pointer;
  transition: background-color 0.2s ease-out;
}

.closebutton:hover {
  background-color: rgba(235, 235, 235, 0.15);
}

.closebutton:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

.popup-img-container {
  height: 100%;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgb(235,235,235) rgb(33,33,33);
  display: flex;
  justify-content: center;
  align-items: center;
}

.popup-img {
  max-width: 100%;
  max-height: 100%;
  object-position: left top;
  object-fit: contain;
  margin: auto;
  display: block;
}

.popup-text {
  min-height: 0;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgb(235,235,235) rgb(33,33,33);
  padding-block: 30px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.popup-title {
  margin-bottom: 1.6em;
  font-size: 2rem;
  text-wrap: balance;
}

.popup-description {
  font-size: 1.2rem;
  line-height: 1.6;
}

.popup-description code {
  padding: .15rem .3rem;
  border-radius: .25rem;
  color: #0d0d0d;
  font-size: .875em;
  font-weight: 500;
  background-color: #ececec;
}

/* TEMP DEBUG: the light rules are written twice so the theme button can force them. */
@media (prefers-color-scheme: light) {
  :global(:root:not([data-theme])) .bento-item {
    border-radius: 0px;
    box-shadow: 5px 5px black;
    border: 3px solid black;
  }

  :global(:root:not([data-theme])) .bento-item .content {
    border-radius: 0px;
    filter: none;
    border: 3px solid black;
  }
}

:global(:root[data-theme="light"]) .bento-item {
  border-radius: 0px;
  box-shadow: 5px 5px black;
  border: 3px solid black;
}

:global(:root[data-theme="light"]) .bento-item .content {
  border-radius: 0px;
  filter: none;
  border: 3px solid black;
}

.tech-stack {
  margin-top: 2rem;
}

.tech-stack-title {
  margin-bottom: .75rem;
  font-size: .85rem;
  letter-spacing: .08em;
  text-transform: uppercase;
  opacity: .7;
}

.tech-stack-list {
  margin: 0;
  padding: 0;
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: .5rem;
}

.tech-stack-item {
  padding: .3rem .75rem;
  border-radius: 999px;
  color: #0d0d0d;
  font-size: .9rem;
  font-weight: 500;
  background-color: #b4ffda;
}

@media screen and (width < 960px) {
  .bento-container {
    grid-template-areas: 
    "a b"
    "a c"
    "d e"
    "f e"
    "g g";
  }
}

@media screen  and (width < 720px) {
  .bento-container {
    height:fit-content;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
    grid-template-areas: unset;
  }

  .bento-container .bento-item {
    grid-area: unset;
    aspect-ratio: 1 / 1.33;
  }

  .bento-item .content {
    min-height: unset;
  }

  .project-popup[open] {
    padding: 3.25rem 1.25rem 1.5rem;
  }

  .popup-wrapper {
    height: auto;
    grid-template-columns: 1fr;
    row-gap: 1.5rem;
  }

  .popup-img-container {
    max-height: 45dvh;
  }

  .popup-text {
    padding-block: 0;
  }

  .popup-title {
    margin-bottom: 0.75em;
    font-size: 1.5rem;
  }

  .popup-description {
    font-size: 1rem;
  }
}

@media screen and (width < 540px) {
  .bento-container {
    grid-template-columns: 1fr;
  }
}
</style>